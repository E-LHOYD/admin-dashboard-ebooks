# Supabase project that stores the book files.
# URL and anon key are public: they ship to the browser.
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only. Never expose this to the browser: it bypasses all storage rules.
# Used solely by /api/uploads/sign to authorise one upload at a time.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
